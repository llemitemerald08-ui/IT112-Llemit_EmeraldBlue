#include <stdio.h>
 
int main(void) {
    /* ---------- Part 1: Finding the Largest Element in an Array ---------- */
    int n, i;
 
    printf("Enter number of elements in the array: ");
    scanf("%d", &n);
 
    int arr[n];
 
    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
 
    int largest = arr[0];
    for (i = 1; i < n; i++) {
        if (arr[i] > largest) {
            largest = arr[i];
        }
    }
 
    printf("The largest element in the array is: %d\n", largest);
 
    /* ---------- Part 2: Counting the Number of Vowels in a String ---------- */
    char str[200];
    int vowels = 0;
 
    getchar(); /* consume leftover newline from previous input */
 
    printf("\nEnter a string: ");
    fgets(str, sizeof(str), stdin);
 
    for (i = 0; str[i] != '\0'; i++) {
        char c = tolower(str[i]);
        if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u') {
            vowels++;
        }
    }
 
    printf("The number of vowels in the string is: %d\n", vowels);
 
    return 0;
}
