#include <stdio.h>

int main(void) {
    int num, total = 0;

    printf("Enter positive numbers to ADD (zero or negative number to STOP)\n");
    printf("\n");

    while (1) {
        printf("Enter a number: ");
        scanf("%d", &num);

        if (num <= 0) {
            break;
        }

        total += num;
    }

    printf("Total sum is: %d\n", total);

    return 0;           
}
