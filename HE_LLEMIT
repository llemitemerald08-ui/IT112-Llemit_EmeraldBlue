#include <stdio.h>

#define MIN_BALANCE 100.00

int main(void) {
    double balance = 500.00;
    double amount;
    int choice;

    do {
        printf("\nBSIT BANK\n");
        printf("Please Select your Transaction\n");
        printf("[1] Balance Inquiry\n");
        printf("[2] Deposit\n");
        printf("[3] Withdraw\n");
        printf("[4] Exit\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1) {
            /* Non-numeric input: clear the buffer and ask again */
            while (getchar() != '\n');
            printf("\nInvalid input! Please enter a number from 1 to 4.\n");
            choice = 0;
            continue;
        }

        switch (choice) {
            case 1:
                printf("\nYour current balance: P%.2f\n", balance);
                break;

            case 2:
                printf("Enter amount to deposit: ");
                if (scanf("%lf", &amount) != 1 || amount <= 0) {
                    while (getchar() != '\n');
                    printf("Invalid amount! Deposit must be greater than P0.00.\n");
                } else {
                    balance += amount;
                    printf("P%.2f deposited successfully!\n", amount);
                }
                break;

            case 3:
                printf("Enter amount to withdraw: ");
                if (scanf("%lf", &amount) != 1 || amount <= 0) {
                    while (getchar() != '\n');
                    printf("Invalid amount! Withdrawal must be greater than P0.00.\n");
                } else if (balance - amount < MIN_BALANCE) {
                    printf("Withdrawal denied! You must maintain at least P100.00 in your account\n");
                } else {
                    balance -= amount;
                    printf("You withdrew P%.2f successfully!\n", amount);
                }
                break;

            case 4:
                printf("\nThank you for banking with BSIT BANK. Goodbye!\n");
                break;

            default:
                printf("\nInvalid choice! Please select 1, 2, 3, or 4.\n");
        }
    } while (choice != 4);

    return 0;
}
